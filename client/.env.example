# Optional, and read at BUILD time. By default the app calls the relative URL /api, which Vite (dev) and
# nginx (Docker) forward to the backend, so no setting is needed. Set this only if the API is on another
# origin (then also set CLIENT_URL on the backend so CORS allows it). It must include the /api prefix.
# VITE_API_BASE_URL=https://api.example.com/api

# Where the dev server forwards /api. Default: http://localhost:4000
# VITE_DEV_API_TARGET=http://localhost:4000
