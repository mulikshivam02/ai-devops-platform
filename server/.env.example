NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27018/changelens
CLIENT_URL=http://localhost:5173
AUTH_DISABLED=false
# Reverse-proxy hops in front of the API (docker compose's nginx = 1). 0 when clients connect directly.
TRUST_PROXY=0
ALLOW_PUBLIC_REGISTRATION=false
JWT_SECRET=replace-with-a-long-development-secret
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=120000

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_TIMEOUT_MS=15000

KUBERNETES_API_URL=
KUBERNETES_TOKEN=
# PEM text, or a path to a PEM file, for a cluster whose API server uses a private CA.
# In-cluster: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
KUBERNETES_CA_CERT=
KUBERNETES_TIMEOUT_MS=10000

PROMETHEUS_API_URL=
PROMETHEUS_TOKEN=
PROMETHEUS_TIMEOUT_MS=10000

LOKI_API_URL=
LOKI_TOKEN=
LOKI_TIMEOUT_MS=10000

AI_PROVIDER=ollama
JSON_BODY_LIMIT=1mb
APP_VERSION=0.1.0