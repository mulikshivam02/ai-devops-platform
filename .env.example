# Copy this file to .env in the repo root (same folder as docker-compose.yml).
# `docker compose` reads a root .env automatically -- these are NOT read by the
# server directly (that's server/.env, a separate file for running the server
# outside Docker). See review 1.7.
#
# Generate a JWT_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

JWT_SECRET=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# Optional integrations -- leave blank to disable
GITHUB_TOKEN=
KUBERNETES_API_URL=
KUBERNETES_TOKEN=
# PEM text (use literal \n for newlines) or a path to a PEM file mounted into the backend container
KUBERNETES_CA_CERT=
PROMETHEUS_API_URL=
PROMETHEUS_TOKEN=
LOKI_API_URL=
LOKI_TOKEN=
